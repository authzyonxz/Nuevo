<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título do Topo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="MenagerFF Android Beta"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- Status Atual -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="STATUS: AGUARDANDO ATIVAÇÃO"
        android:textColor="#FBBF24"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <!-- Botões de Configuração (Shizuku & Pasta SAF) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnShizuku"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:backgroundTint="#1E293B"
            android:text="Abrir Shizuku"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:backgroundTint="#1E293B"
            android:text="Selecionar Pasta"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Botão Principal de Ativação / Injeção -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#0284C7"
        android:text="ATIVAR HS PESCOÇO"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Console de Logs Detalhado -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Console de Logs e Atividades:"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E293B"
        android:padding="8dp">

        <TextView
            android:id="@+id/logConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Iniciado] MenagerFF pronto para operação..."
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
