<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E15"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Título Principal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="MenagerFF Android"
        android:textAlignment="center"
        android:textColor="#00E5FF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#1A1C29"
        android:padding="12dp"
        android:text="STATUS: AGUARDANDO ADB"
        android:textColor="#FFD700"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Configuração ADB Wireless -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etAdbPort"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#16192B"
            android:hint="Porta ADB"
            android:inputType="number"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAdbCode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#16192B"
            android:hint="Código 6 Dígitos"
            android:inputType="number"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConnectAdb"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#007ACC"
        android:text="CONECTAR ADB WIRELESS"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- Botão de Mod -->
    <Button
        android:id="@+id/btnToggleMod"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#00C853"
        android:text="ATIVAR HS PESCOÇO"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Console de Logs -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Logs do Sistema:"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:background="#12141F"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Iniciado] MenagerFF pronto.\n"
            android:textColor="#00E676"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
