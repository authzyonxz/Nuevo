<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16jp"
    android:padding="16dp">

    <!-- Título do Topo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="MenagerFF Android Beta"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <!-- Status Atual -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="STATUS: AGUARDANDO PAREAMENTO ADB"
        android:textColor="#FBBF24"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="10dp" />

    <!-- Seção de Pareamento ADB Wireless (Sem Shizuku) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pareamento ADB Wireless (Sem Shizuku)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/editPort"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="#0F172A"
                android:hint="Porta (Ex: 37482)"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp"
                android:inputType="number"
                android:padding="8dp" />

            <EditText
                android:id="@+id/editCode"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="#0F172A"
                android:hint="Código (6 Dígitos)"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp"
                android:inputType="number"
                android:padding="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConnectAdb"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="#0284C7"
            android:text="CONECTAR E PAREAR ADB"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botão Principal de Ativação / Injeção -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#059669"
        android:text="ATIVAR HS PESCOÇO"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Console de Logs Detalhado -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Console de Logs e Atividades:"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:paddingBottom="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E293B"
        android:padding="8dp">

        <TextView
            android:id="@+id/logConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Iniciado] MenagerFF pronto. Insira porta e código ADB para conectar..."
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
