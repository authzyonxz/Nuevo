<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E15"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Título Principal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="MenagerFF Android Beta"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="#1A1C29"
        android:padding="12dp"
        android:text="Status: Aguardando Pareamento ADB / Shizuku"
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Botões de Ação -->
    <Button
        android:id="@+id/btnPair"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#007ACC"
        android:text="1. PAREAR ADB (TELA DIVIDIDA)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnInject"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#00C853"
        android:text="2. ATIVAR HS PESCOÇO (INJETAR)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRestore"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#D50000"
        android:text="3. RESTAURAR ORIGINAL (DESLIGAR)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Console de Logs -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Logs de Execução:"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:background="#12141F"
        android:padding="10dp">

        <TextView
            android:id="@+id/logConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> Sistema inicializado.\n> Pronto para conexão com Free Fire (com.dts.freefireth)."
            android:textColor="#00E676"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
